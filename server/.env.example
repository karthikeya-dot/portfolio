PORT=5000
CLIENT_URL=http://localhost:5173
# Optional: without MONGO_URI messages are not stored
MONGO_URI=mongodb://127.0.0.1:27017/portfolio
# Optional: without SMTP_* no email is sent (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=satyasuryakarthikeya@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=satyasuryakarthikeya@gmail.com
# Excel file where every message is saved (default: server/data/messages.xlsx)
EXCEL_PATH=./data/messages.xlsx
# Optional: set to download the sheet at /api/messages/download?key=YOUR_KEY
ADMIN_KEY=change-me
